{
  "name": "context-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Organisational Context Engine: approved, versioned organisational knowledge for people and AI agents.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "db",
    "api",
    "worker",
    "web",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check:isolation": "node scripts/check-isolation.ts",
    "migrate": "node db/src/migrate.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
