# Copy to .env and fill in every value. Never commit .env (NFR5.2).
# Values are secrets or install-specific; none has a default here on purpose.

# Database connections, one role each (security design, three roles).
# Self-hosted: postgres://ce_api:<CE_API_PASSWORD>@postgres:5432/ce
DATABASE_URL_API=
DATABASE_URL_WORKER=
DATABASE_URL_MIGRATE=

# Role passwords, read by the postgres container's init script (db/init/01-roles.sql).
# POSTGRES_PASSWORD is the self-hosted container's superuser; nothing in the product uses it.
POSTGRES_PASSWORD=
CE_MIGRATE_PASSWORD=
CE_API_PASSWORD=
CE_WORKER_PASSWORD=

# Better Auth signing secret (at least 32 random characters).
BETTER_AUTH_SECRET=

# Address shape: organisations are served at https://<address>.<PUBLIC_BASE_DOMAIN>
PUBLIC_BASE_DOMAIN=
# Port Caddy publishes for HTTPS (443 in production).
PUBLIC_PORT=
# Image tag to run (a commit SHA or a release version), and where images come from,
# for example ghcr.io/<owner>/context-engine (empty: images built locally).
IMAGE_TAG=
IMAGE_PREFIX=

# Self-hosted: the install's address(es) Caddy serves (empty: acme.localhost, globex.localhost).
SITE_ADDRESS=
# Hosted service only: the service address, the DNS provider's API token for the wildcard
# certificate, and TLS_MODE (empty means dns; internal uses Caddy's local CA).
SERVICE_ADDRESS=
DNS_API_TOKEN=
TLS_MODE=
# Hosted service only: path on the VM to Supabase's CA certificate (sslmode=verify-full).
SUPABASE_CA_FILE=

# Seeded accounts for the two local organisations (acme, globex).
SEED_ACME_CONTRIBUTOR_PASSWORD=
SEED_ACME_OWNER_PASSWORD=
SEED_ACME_AGENT_TOKEN=
SEED_GLOBEX_OWNER_PASSWORD=
SEED_GLOBEX_AGENT_TOKEN=

# Seeded accounts for the hosted test organisations (e2e-a, e2e-b); leave empty elsewhere.
SEED_E2E_A_CONTRIBUTOR_PASSWORD=
SEED_E2E_A_OWNER_PASSWORD=
SEED_E2E_A_AGENT_TOKEN=
SEED_E2E_B_OWNER_PASSWORD=
SEED_E2E_B_AGENT_TOKEN=
